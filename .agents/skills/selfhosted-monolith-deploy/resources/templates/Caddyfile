# =============================================================================
# Universal Production Caddyfile Template
# =============================================================================
# Caddy automatically obtains and renews TLS certificates via Let's Encrypt / ZeroSSL.
# Replace {$DOMAIN} with your actual domain (e.g. example.com or app.example.com).
# =============================================================================

{$DOMAIN:localhost} {
    # Modern compression
    encode zstd gzip

    # -------------------------------------------------------------------------
    # Option 1: Unified Monolith (Single upstream service)
    # -------------------------------------------------------------------------
    reverse_proxy app:${APP_PORT:-3000} {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # -------------------------------------------------------------------------
    # Option 2: Split Monolith (Frontend on root, Backend API on /api/*)
    # (Uncomment this block and remove Option 1 if using separate containers)
    # -------------------------------------------------------------------------
    # handle /api/* {
    #     reverse_proxy backend:${BACKEND_PORT:-5000} {
    #         header_up X-Real-IP {remote_host}
    #         header_up X-Forwarded-For {remote_host}
    #         header_up X-Forwarded-Proto {scheme}
    #     }
    # }
    #
    # handle {
    #     reverse_proxy frontend:${FRONTEND_PORT:-80} {
    #         header_up X-Real-IP {remote_host}
    #         header_up X-Forwarded-For {remote_host}
    #         header_up X-Forwarded-Proto {scheme}
    #     }
    # }

    # -------------------------------------------------------------------------
    # Standard Security Headers
    # -------------------------------------------------------------------------
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # -------------------------------------------------------------------------
    # Logging
    # -------------------------------------------------------------------------
    log {
        output stdout
        format console
    }
}
