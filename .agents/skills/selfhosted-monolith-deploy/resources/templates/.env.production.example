# =============================================================================
# Production Environment Variables Template
# =============================================================================
# Copy this file to .env (or your application's designated env file) on your VPS.
# =============================================================================

# Project & Domain
COMPOSE_PROJECT_NAME=my_monolith_app
DOMAIN=app.example.com
APP_PORT=3000

# Database Configuration (PostgreSQL / MySQL / MariaDB)
DB_IMAGE=postgres:16-alpine
DB_USER=app_user
DB_PASSWORD=replace_with_a_secure_database_password
DB_NAME=app_production

# Cache / Queue (Optional - Redis)
REDIS_PASSWORD=replace_with_a_secure_redis_password
REDIS_MAXMEMORY=256mb

# Application Secrets (JWT, App Key, Session Secret, etc.)
# SECRET_KEY_BASE=
# APP_KEY=
# JWT_SECRET=
