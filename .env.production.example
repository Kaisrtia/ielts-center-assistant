# =============================================================================
# Production Environment Variables Template - IELTS Center Assistant
# =============================================================================
# Copy this file to .env on your VPS host in your project directory:
#   cp .env.production.example .env
# =============================================================================

# Project & Domain
COMPOSE_PROJECT_NAME=ielts-center
DOMAIN=ielts.example.com
FRONTEND_PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# [PHASE 2 - BACKEND CONFIGURATION]
# Uncomment and configure these when adding the NestJS backend & database
# -----------------------------------------------------------------------------
# BACKEND_PORT=5000
# DB_USER=ielts_user
# DB_PASSWORD=replace_with_strong_database_password
# DB_NAME=ielts_db
# REDIS_PASSWORD=replace_with_strong_redis_password
# JWT_SECRET=replace_with_jwt_secret
